# App
APP_NAME=Retail OS
DEBUG=false
ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/retail_os

# Redis
REDIS_URL=redis://localhost:6379

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=retail_os_queue
# How often TenantReconciliationWorkflow retries failed onboarding steps.
RECONCILIATION_INTERVAL_MINUTES=60

# WhatsApp (Meta Cloud API)
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v25.0
# Platform Meta App credentials; APP_SECRET also verifies inbound webhook signatures.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# hub.verify_token for the GET webhook handshake only.
WHATSAPP_WEBHOOK_SECRET=
# System User with a non-expiring token (whatsapp_business_management + _messaging + _manage_events).
WHATSAPP_SYSTEM_USER_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
# Extended credit line ID, shared with each tenant's WABA during onboarding.
WHATSAPP_EXTENDED_CREDIT_ID=
# Optional number to smoke-test a newly registered tenant number; blank to skip.
WHATSAPP_TEST_RECIPIENT_NUMBER=
# phone_number_id on Retail OS's own platform WABA — sends login/signup OTPs.
WHATSAPP_OTP_SENDER_PHONE_NUMBER_ID=
# Approved AUTHENTICATION template for OTP; leave NAME empty for dev free-form text.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

# CORS — comma-separated browser origins; empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=

# Security
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Separate key that encrypts WhatsApp two-step PINs at rest.
PIN_ENCRYPTION_KEY=

# OTP (login/signup codes; ephemeral state in Redis)
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limiting — per-IP limits on public auth endpoints. Format: "<count>/<minute|hour|day>".
RATE_LIMIT_OTP_REQUEST=20/minute
RATE_LIMIT_EMAIL_LOGIN=10/minute
RATE_LIMIT_EMAIL_SIGNUP=10/minute
