# App
APP_NAME=Retail OS
DEBUG=false
ENVIRONMENT=development
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/retail_os

# Redis
REDIS_URL=redis://localhost:6379

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=retail_os_queue
# How often TenantReconciliationWorkflow retries failed credit-share / phone
# registration steps from onboarding.
RECONCILIATION_INTERVAL_MINUTES=60

# WhatsApp (Meta Cloud API — Solution Partner, shared credit line)
WHATSAPP_API_URL=https://graph.facebook.com
# Bump periodically — Graph API versions sunset ~2 years after release.
# Check https://developers.facebook.com/documentation/business-messaging/whatsapp/embedded-signup/versions/
WHATSAPP_API_VERSION=v25.0
# Platform-level Meta App credentials (not per-tenant).
# APP_SECRET also verifies the X-Hub-Signature-256 on every inbound webhook.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
# hub.verify_token for the GET handshake ONLY (an arbitrary string you also
# enter in the Meta dashboard). NOT used for payload signature verification.
WHATSAPP_WEBHOOK_SECRET=
# System User — create once in Meta Business Manager; token never expires
# Business Settings → System Users → Add → Generate Token. When generating
# the token, include whatsapp_business_management, whatsapp_business_messaging,
# and whatsapp_business_manage_events permissions — the Register API and
# credit-sharing calls (including reconciliation retries) require them.
WHATSAPP_SYSTEM_USER_ID=
WHATSAPP_SYSTEM_USER_TOKEN=
# Solution Partner — your extended credit line ID (Business Manager > Extended
# Credits). Shared with each tenant's WABA during onboarding so distributors
# never add their own WhatsApp payment method.
WHATSAPP_EXTENDED_CREDIT_ID=
# Optional — a WhatsApp number you control, used only to smoke-test a newly
# registered tenant number right after onboarding. Leave blank to skip.
WHATSAPP_TEST_RECIPIENT_NUMBER=
# A phone_number_id on Retail OS's own platform WABA — sends login/signup
# OTP codes, since a distributor has no WABA of their own until after they
# sign up. Register this number once under the same Business Manager as the
# System User, independent of any tenant.
WHATSAPP_OTP_SENDER_PHONE_NUMBER_ID=

# CORS — comma-separated browser origins allowed to call this API, e.g.
# https://app.retailos.com,https://admin.retailos.com. Empty = no
# cross-origin browser access (safe default; set explicitly per environment).
CORS_ALLOWED_ORIGINS=

# Security
# Signs access + refresh JWTs issued at signup/login (app/core/security.py).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Separate from SECRET_KEY on purpose — derives the key that encrypts
# WhatsApp two-step PINs at rest (app/core/security.py).
PIN_ENCRYPTION_KEY=

# OTP (login/signup verification codes — app/core/security.py, app/services/otp.py)
# Pending state lives in Redis only, keyed by phone + purpose, and expires
# automatically — nothing to clean up.
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limiting (app/core/rate_limit.py) — per-IP limits on public auth
# endpoints, Redis-backed via slowapi. Format: "<count>/<second|minute|hour|day>".
# Separate from OTP_RESEND_COOLDOWN_SECONDS above, which is per-phone-number,
# not per-IP.
RATE_LIMIT_OTP_REQUEST=20/minute
RATE_LIMIT_EMAIL_LOGIN=10/minute
RATE_LIMIT_EMAIL_SIGNUP=10/minute
